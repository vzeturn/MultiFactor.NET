<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>MM.Auth</PackageId>
    <Description>Multi-factor authentication core: factor abstraction, orchestration, storage and secret-protection seams. No database driver, no cipher, no factor implementation.</Description>
    <!-- The xunit PackageReference below sets IsTestProject=true via xunit.core.props, which
         makes the SDK default IsPackable to false. This project ships as a real NuGet package
         despite carrying xunit as a runtime dependency, so IsPackable is forced back on. -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <!-- xunit + AwesomeAssertions are real runtime dependencies of this package because
         Testing/MfaRepositoryConformanceTests.cs ships inside it: any adapter author gets
         the behavioural suite by referencing MM.Auth alone. -->
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="AwesomeAssertions" Version="9.4.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- MfaOptions.Table(string) is internal by design (see MfaOptions.cs); the test project
         needs to exercise it directly rather than only through public behaviour. -->
    <InternalsVisibleTo Include="MM.Auth.Tests" />
    <!-- SqliteMfaRepository (Task 8) calls MfaOptions.Table(string) to build its SQL text; the
         method is internal by design, so the adapter assembly needs visibility into it. -->
    <InternalsVisibleTo Include="MM.Auth.Sqlite" />
  </ItemGroup>

</Project>
