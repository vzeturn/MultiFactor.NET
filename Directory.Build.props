<Project>
  <PropertyGroup>
    <!-- Single target on purpose. MM.Mfa needed net10.0-windows as a statement of intent
         about DPAPI; MM.Auth has no platform-bound API left, so a second TFM would only
         double build time and split the test matrix for no behavioural difference. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Company>SMILE PMS</Company>
    <Authors>SMILE PMS</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
